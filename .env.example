# These are read from the process environment. The program does not load .env files itself,
# so export them in your shell (or set them in your MCP client config).
# Folder of .md/.txt notes to expose (default: ./sample_notes)
DOCS_DIR=sample_notes
# Leave unset/false in real use. Only set to true to let fetch_url reach localhost/private IPs (e.g. in tests).
ALLOW_PRIVATE_FETCH=false
LOG_LEVEL=INFO
